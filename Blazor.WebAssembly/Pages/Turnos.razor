@page "/turnos"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Turnos</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Turnos</h3>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Hora Inicio</th>
                                <th>Hora Fin</th>
                                <th>Profesional</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (turnos != null && turnos.Any())
                            {
                                @foreach (var turno in turnos)
                                {
                                    var profesional = profesionales?.FirstOrDefault(p => p.Id == turno.ProfesionalId);
                                    <tr>
                                        <td>@turno.Id</td>
                                        <td>@turno.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@turno.FechaHoraInicio.ToString("HH:mm")</td>
                                        <td>@turno.FechaHoraFin.ToString("HH:mm")</td>
                                        <td>@profesional?.Apellido, @profesional?.Nombre</td>
                                        <td>@turno.EstadoTurno</td>
                                        <td>@turno.Motivo</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(turno)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(turno)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<TurnoModal @ref="turnoModal" OnTurnoChanged="LoadTurnos" />

@code {
    private List<TurnoDTO>? turnos;
    private List<ProfesionalDTO>? profesionales;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private TurnoModal turnoModal = null!;
    
    // Permisos de autorización
    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verificar permisos
        await LoadPermissions();
        
        // Solo cargar datos si tiene permiso de lectura
        if (canRead)
        {
            await LoadTurnos();
        }
        else
        {
            errorMessage = "No tiene permisos para ver turnos.";
            loading = false;
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("Administrativo");
        canAdd = await AuthService.HasPermissionAsync("Administrativo");
        canUpdate = await AuthService.HasPermissionAsync("Administrativo");
        canDelete = await AuthService.HasPermissionAsync("Administrativo");
    }

    private async Task LoadTurnos()
    {
        try
        {
            loading = true;
            profesionales = (await ProfesionalApiClient.GetAllAsync())?.ToList();
            turnos = (await TurnoApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty; // Clear success message when reloading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar turnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        await turnoModal.ShowAddModal();
    }

    private async Task OpenEditModal(TurnoDTO turno)
    {
        await turnoModal.ShowEditModal(turno);
    }

    private async Task ConfirmDelete(TurnoDTO turno)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar el turno {turno.Id} ({turno.FechaHoraInicio:dd/MM/yyyy HH:mm})?");
        
        if (confirm)
        {
            await DeleteTurno(turno.Id);
        }
    }

    private async Task DeleteTurno(int id)
    {
        try
        {
            await TurnoApiClient.DeleteAsync(id);
            successMessage = "Turno eliminado exitosamente.";
            await LoadTurnos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar turno: {ex.Message}";
        }
    }
}
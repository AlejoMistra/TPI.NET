@page "/pacientes"
@using DTOs
@using API.Clients
@using Blazor.Server.Components
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Pacientes</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Pacientes</h3>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (canRead)
            {
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Buscar</label>
                        <input type="text" class="form-control" placeholder="Nombre, apellido o DNI"
                               @bind="textoBusqueda" @bind:event="oninput" @onkeydown="OnTextoKeyDown" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Obra Social</label>
                        @* @key: si cambian las opciones, el select se recrea y muestra el valor elegido *@
                        <select class="form-select" @bind="obraSocialFiltro" @key="string.Join('|', obrasSociales)">
                            <option value="Todas">Todas</option>
                            <option value="Particular">Particular</option>
                            @foreach (var obraSocial in obrasSociales)
                            {
                                <option value="@obraSocial">@obraSocial</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Especialidad</label>
                        <select class="form-select" @bind="especialidadFiltro" @bind:after="OnEspecialidadChanged">
                            <option value="0">Todas las especialidades</option>
                            @if (especialidades != null)
                            {
                                @foreach (var especialidad in especialidades)
                                {
                                    <option value="@especialidad.Id">@especialidad.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Profesional</label>
                        <select class="form-select" @bind="profesionalFiltro" @bind:after="OnProfesionalChanged" @key="especialidadFiltro">
                            <option value="0">Todos los profesionales</option>
                            @foreach (var profesional in ProfesionalesFiltrados)
                            {
                                <option value="@profesional.Id">@profesional.Apellido, @profesional.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-primary me-1" @onclick="Buscar">Buscar</button>
                        <button class="btn btn-link" @onclick="LimpiarFiltros">Limpiar filtros</button>
                    </div>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>N° Doc</th>
                                <th>Fecha Nac. / Edad</th>
                                <th>Obra Social</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pacientes != null && pacientes.Any())
                            {
                                @foreach (var paciente in pacientes)
                                {
                                    <tr>
                                        <td>@paciente.Id</td>
                                        <td>@paciente.Nombre</td>
                                        <td>@paciente.Apellido</td>
                                        <td>@paciente.NroDocumento</td>
                                        <td>@FormatearFechaNacimientoYEdad(paciente.FechaNacimiento)</td>
                                        <td>@(string.IsNullOrWhiteSpace(paciente.ObraSocial) ? "Particular" : paciente.ObraSocial)</td>
                                        <td>@paciente.Telefono</td>
                                        <td>@paciente.Email</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(paciente)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => ConfirmDelete(paciente)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                            @if (canReadHistoria)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="@(() => Navigation.NavigateTo($"/historia-clinica/{paciente.Id}"))">
                                                    Historia Clínica
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<PacienteModal @ref="pacienteModal" OnPacienteChanged="LoadPacientes" />

@code {
    private List<PacienteDTO>? pacientes;
    private List<EspecialidadDTO>? especialidades;
    private List<ProfesionalDTO>? profesionales;
    private List<string> obrasSociales = new();
    private bool loading = true;

    // Filtros de búsqueda (los mismos de la pantalla Pacientes de Escritorio)
    private string textoBusqueda = string.Empty;
    private string obraSocialFiltro = "Todas";
    private int especialidadFiltro;
    private int profesionalFiltro;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private PacienteModal pacienteModal = null!;
    
    // Permisos de autorización
    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;
    private bool canReadHistoria = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verificar autenticación antes de cargar datos
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Verificar permisos
            await LoadPermissions();
            
            // Solo cargar datos si tiene permiso de lectura
            if (canRead)
            {
                await LoadFiltros();
                await LoadPacientes();
            }
            else
            {
                errorMessage = "No tiene permisos para ver pacientes.";
            }
            
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("pacientes.leer");
        canAdd = await AuthService.HasPermissionAsync("pacientes.agregar");
        canUpdate = await AuthService.HasPermissionAsync("pacientes.actualizar");
        canDelete = await AuthService.HasPermissionAsync("pacientes.eliminar");
        canReadHistoria = await AuthService.HasPermissionAsync("historiasclinicas.leer");
    }

    private async Task LoadFiltros()
    {
        try
        {
            especialidades = (await EspecialidadApiClient.GetAllAsync())?.OrderBy(e => e.Nombre).ToList();
            profesionales = (await ProfesionalApiClient.GetAllAsync())?.OrderBy(p => p.Apellido).ThenBy(p => p.Nombre).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los filtros: {ex.Message}";
        }
    }

    private async Task LoadPacientes()
    {
        try
        {
            loading = true;

            // Las obras sociales del filtro salen de todos los pacientes, como en Escritorio
            var todos = await PacienteApiClient.GetAllAsync();
            obrasSociales = todos
                .Select(p => p.ObraSocial?.Trim() ?? string.Empty)
                .Where(os => !string.IsNullOrWhiteSpace(os) && !string.Equals(os, "Particular", StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(os => os)
                .ToList();

            // Si la obra social elegida ya no existe, vuelve a "Todas" (como en Escritorio)
            if (obraSocialFiltro != "Todas" && obraSocialFiltro != "Particular" &&
                !obrasSociales.Contains(obraSocialFiltro, StringComparer.OrdinalIgnoreCase))
            {
                obraSocialFiltro = "Todas";
            }

            pacientes = (await PacienteApiClient.GetByCriteriaAsync(Criterio()))?.ToList();
            successMessage = string.Empty; // Clear success message when reloading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar pacientes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // Búsqueda por criterio (ADO.NET en la API)
    private async Task Buscar()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;
            pacientes = (await PacienteApiClient.GetByCriteriaAsync(Criterio()))?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar pacientes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private PacienteCriteriaDTO Criterio() => new PacienteCriteriaDTO
    {
        Texto = textoBusqueda.Trim(),
        ObraSocial = obraSocialFiltro == "Todas" ? null : obraSocialFiltro,
        EspecialidadId = especialidadFiltro > 0 ? especialidadFiltro : null,
        ProfesionalId = profesionalFiltro > 0 ? profesionalFiltro : null
    };

    private IEnumerable<ProfesionalDTO> ProfesionalesFiltrados =>
        (profesionales ?? new()).Where(p => especialidadFiltro == 0 || p.EspecialidadId == especialidadFiltro);

    // Al cambiar la especialidad se acota el combo de profesionales (se mantiene el elegido si pertenece)
    private void OnEspecialidadChanged()
    {
        var profesional = profesionales?.FirstOrDefault(p => p.Id == profesionalFiltro);
        if (profesional != null && especialidadFiltro > 0 && profesional.EspecialidadId != especialidadFiltro)
        {
            profesionalFiltro = 0;
        }
    }

    // Al elegir un profesional, la especialidad pasa a ser la suya
    private void OnProfesionalChanged()
    {
        var profesional = profesionales?.FirstOrDefault(p => p.Id == profesionalFiltro);
        if (profesional != null)
        {
            especialidadFiltro = profesional.EspecialidadId;
        }
    }

    private async Task OnTextoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = string.Empty;
        obraSocialFiltro = "Todas";
        especialidadFiltro = 0;
        profesionalFiltro = 0;
        await Buscar();
    }

    private string FormatearFechaNacimientoYEdad(DateTime fechaNacimiento)
    {
        if (fechaNacimiento <= new DateTime(1900, 1, 1) || fechaNacimiento > DateTime.Today)
            return "—";

        var hoy = DateTime.Today;
        int edad = hoy.Year - fechaNacimiento.Year;
        if (fechaNacimiento.Date > hoy.AddYears(-edad))
            edad--;

        return $"{fechaNacimiento:dd/MM/yyyy} ({edad} años)";
    }

    private async Task OpenAddModal()
    {
        await pacienteModal.ShowAddModal();
    }

    private async Task OpenEditModal(PacienteDTO paciente)
    {
        await pacienteModal.ShowEditModal(paciente);
    }

    private async Task ConfirmDelete(PacienteDTO paciente)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar el paciente {paciente.Nombre} {paciente.Apellido} ({paciente.NroDocumento})?");
        
        if (confirm)
        {
            await DeletePaciente(paciente.Id);
        }
    }

    private async Task DeletePaciente(int id)
    {
        try
        {
            await PacienteApiClient.DeleteAsync(id);
            successMessage = "Paciente eliminado exitosamente.";
            await LoadPacientes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar paciente: {ex.Message}";
        }
    }
}
@page "/facturacion"
@using DTOs
@using API.Clients
@using Blazor.Server.Components
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Facturación</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Facturación</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>N° Turno</th>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Paciente</th>
                                <th>Obra Social</th>
                                <th>Especialidad</th>
                                <th>Profesional</th>
                                <th>Estado Turno</th>
                                <th>Facturación</th>
                                <th>Monto Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (turnos != null && turnos.Any())
                            {
                                @foreach (var turno in turnos)
                                {
                                    <tr>
                                        <td>@turno.Id</td>
                                        <td>@turno.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@turno.FechaHoraInicio.ToString("HH:mm") - @turno.FechaHoraFin.ToString("HH:mm")</td>
                                        <td>@PacienteNombre(turno)</td>
                                        <td>@ObraSocial(turno)</td>
                                        <td>@EspecialidadNombre(turno)</td>
                                        <td>@ProfesionalNombre(turno)</td>
                                        <td>@turno.EstadoTurno</td>
                                        <td>@(turno.FacturaId.HasValue ? $"Facturado (#{turno.FacturaId.Value:D5})" : "Pendiente")</td>
                                        <td>@MontoTotalTexto(turno)</td>
                                        <td>
                                            @if (canAdd && !turno.FacturaId.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAddModal(turno)">
                                                    Facturar
                                                </button>
                                            }
                                            @if (canUpdate && turno.FacturaId.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => OpenConsultaModal(turno)">
                                                    Ver Factura
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<FacturaModal @ref="facturaModal" OnFacturaChanged="LoadTurnos" />

@code {
    private List<TurnoDTO>? turnos;
    private List<FacturaDTO>? facturas;
    private List<PacienteDTO>? pacientes;
    private List<ProfesionalDTO>? profesionales;
    private List<EspecialidadDTO>? especialidades;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private FacturaModal facturaModal = null!;

    // Permisos de autorización
    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verificar autenticación antes de cargar datos
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Verificar permisos
            await LoadPermissions();

            // Solo cargar datos si tiene permiso de lectura
            if (canRead)
            {
                await LoadTurnos();
            }
            else
            {
                errorMessage = "No tiene permisos para ver la facturación.";
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("Administrativo");
        canAdd = await AuthService.HasPermissionAsync("Administrativo");
        canUpdate = await AuthService.HasPermissionAsync("Administrativo");
    }

    private async Task LoadTurnos()
    {
        try
        {
            loading = true;
            especialidades = (await EspecialidadApiClient.GetAllAsync())?.ToList();
            profesionales = (await ProfesionalApiClient.GetAllAsync())?.ToList();
            pacientes = (await PacienteApiClient.GetAllAsync())?.ToList();
            facturas = (await FacturaApiClient.GetAllAsync())?.ToList();
            // Solo turnos en estados facturables: Asignado, Presente o Atendido
            turnos = (await TurnoApiClient.GetAllAsync())?
                .Where(t => t.EstadoTurno == "Asignado" || t.EstadoTurno == "Presente" || t.EstadoTurno == "Atendido")
                .OrderByDescending(t => t.FechaHoraInicio)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar la facturación: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string PacienteNombre(TurnoDTO turno)
    {
        var paciente = pacientes?.FirstOrDefault(p => p.Id == turno.PacienteId);
        return paciente != null ? $"{paciente.Apellido}, {paciente.Nombre} (DNI: {paciente.NroDocumento})" : "— Sin Asignar —";
    }

    private string ObraSocial(TurnoDTO turno)
    {
        var paciente = pacientes?.FirstOrDefault(p => p.Id == turno.PacienteId);
        return paciente != null && !string.IsNullOrWhiteSpace(paciente.ObraSocial) ? paciente.ObraSocial : "Particular";
    }

    private string ProfesionalNombre(TurnoDTO turno)
    {
        var profesional = profesionales?.FirstOrDefault(p => p.Id == turno.ProfesionalId);
        return profesional != null ? $"{profesional.Apellido}, {profesional.Nombre}" : $"ID {turno.ProfesionalId}";
    }

    private string EspecialidadNombre(TurnoDTO turno)
    {
        var profesional = profesionales?.FirstOrDefault(p => p.Id == turno.ProfesionalId);
        return especialidades?.FirstOrDefault(e => e.Id == profesional?.EspecialidadId)?.Nombre ?? "—";
    }

    private string MontoTotalTexto(TurnoDTO turno)
    {
        var factura = facturas?.FirstOrDefault(f => f.Id == turno.FacturaId);
        return factura != null ? $"$ {factura.MontoTotal:N2}" : "—";
    }

    private async Task OpenAddModal(TurnoDTO turno)
    {
        await facturaModal.ShowAddModal(turno);
    }

    private async Task OpenConsultaModal(TurnoDTO turno)
    {
        await facturaModal.ShowConsultaModal(turno);
    }
}

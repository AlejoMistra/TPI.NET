@page "/agenda"
@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Agenda de Turnos</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Agenda de Turnos</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Hora Inicio</th>
                                <th>Hora Fin</th>
                                <th>Profesional</th>
                                <th>Paciente</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (turnos != null && turnos.Any())
                            {
                                @foreach (var turno in turnos)
                                {
                                    <tr>
                                        <td>@turno.Id</td>
                                        <td>@turno.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@turno.FechaHoraInicio.ToString("HH:mm")</td>
                                        <td>@turno.FechaHoraFin.ToString("HH:mm")</td>
                                        <td>@ProfesionalNombre(turno)</td>
                                        <td>@PacienteNombre(turno)</td>
                                        <td>@turno.EstadoTurno</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(turno)">
                                                Ver Detalle
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TurnoDTO>? turnos;
    private List<ProfesionalDTO>? profesionales;
    private List<PacienteDTO>? pacientes;
    private bool loading = true;
    private string errorMessage = string.Empty;

    // Permisos de autorización
    private bool canRead = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verificar autenticación antes de cargar datos
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Verificar permisos
            await LoadPermissions();
            
            // Solo cargar datos si tiene permiso de lectura
            if (canRead)
            {
                await LoadTurnos();
            }
            else
            {
                errorMessage = "No tiene permisos para ver la agenda de turnos.";
            }
            
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("Administrativo");
    }

    private async Task LoadTurnos()
    {
        try
        {
            loading = true;
            profesionales = (await ProfesionalApiClient.GetAllAsync())?.ToList();
            pacientes = (await PacienteApiClient.GetAllAsync())?.ToList();
            turnos = (await TurnoApiClient.GetAllAsync())?.OrderBy(t => t.FechaHoraInicio).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar la agenda de turnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string ProfesionalNombre(TurnoDTO turno)
    {
        var profesional = profesionales?.FirstOrDefault(p => p.Id == turno.ProfesionalId);
        return profesional != null ? $"{profesional.Apellido}, {profesional.Nombre}" : $"ID {turno.ProfesionalId}";
    }

    private string PacienteNombre(TurnoDTO turno)
    {
        var paciente = pacientes?.FirstOrDefault(p => p.Id == turno.PacienteId);
        return paciente != null ? $"{paciente.Apellido}, {paciente.Nombre} (DNI: {paciente.NroDocumento})" : "— Sin Asignar —";
    }

    private async Task VerDetalle(TurnoDTO turno)
    {
        await JSRuntime.InvokeVoidAsync("alert",
            $"Turno N° {turno.Id}\n" +
            $"Fecha: {turno.FechaHoraInicio:dd/MM/yyyy} ({turno.FechaHoraInicio:HH:mm} - {turno.FechaHoraFin:HH:mm})\n" +
            $"Profesional: {ProfesionalNombre(turno)}\n" +
            $"Paciente: {PacienteNombre(turno)}\n" +
            $"Estado: {turno.EstadoTurno}\n" +
            $"Motivo: {turno.Motivo}");
    }
}

@using API.Clients
@inject IAuthService AuthService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor Server</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @if (canReadAgenda)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="agenda">
                    <span class="oi oi-people" aria-hidden="true"></span> Agenda de Turnos
                </NavLink>
            </div>
        }
        @if (canReadPacientes)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pacientes">
                    <span class="oi oi-people" aria-hidden="true"></span> Pacientes
                </NavLink>
            </div>
        }
        @if (canReadFacturacion)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="facturacion">
                    <span class="oi oi-people" aria-hidden="true"></span> Facturación
                </NavLink>
            </div>
        }
        @if (canReadTurnos)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="turnos">
                    <span class="oi oi-people" aria-hidden="true"></span> Turnos
                </NavLink>
            </div>
        }
        @if (canReadProfesionales)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profesionales">
                    <span class="oi oi-people" aria-hidden="true"></span> Profesionales
                </NavLink>
            </div>
        }
        @if (canReadEspecialidades)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="especialidades">
                    <span class="oi oi-people" aria-hidden="true"></span> Especialidades
                </NavLink>
            </div>
        }
        @if (canReadUsuarios)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="oi oi-people" aria-hidden="true"></span> Usuarios
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool canReadAgenda = false;
    private bool canReadFacturacion = false;
    private bool canReadPacientes = false;
    private bool canReadTurnos = false;
    private bool canReadProfesionales = false;
    private bool canReadEspecialidades = false;
    private bool canReadUsuarios = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        // Suscribirse a cambios de autenticación
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await CheckPermissions();
        await base.OnInitializedAsync();
    }

    private async Task CheckPermissions()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            canReadAgenda = await AuthService.HasPermissionAsync("turnos.leer");
            canReadPacientes = await AuthService.HasPermissionAsync("pacientes.leer");
            canReadFacturacion = await AuthService.HasPermissionAsync("facturas.leer");
            canReadTurnos = await AuthService.HasPermissionAsync("datosmaestros.leer");
            canReadProfesionales = await AuthService.HasPermissionAsync("datosmaestros.leer");
            canReadEspecialidades = await AuthService.HasPermissionAsync("datosmaestros.leer");
            canReadUsuarios = await AuthService.HasPermissionAsync("usuarios.leer");
        }
        else
        {
            canReadAgenda = false;
            canReadFacturacion = false;
            canReadPacientes = false;
            canReadTurnos = false;
            canReadProfesionales = false;
            canReadEspecialidades = false;
            canReadUsuarios = false;
        }
        StateHasChanged(); // Forzar re-render
    }

    private void OnAuthenticationStateChanged(bool authenticated)
    {
        InvokeAsync(async () =>
        {
            await CheckPermissions();
        });
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Nuevo Registro Clínico - Historia Clínica @(historiaClinica != null ? $"#{historiaClinica.Id:D5}" : "(nueva)")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentRegistro" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Paciente</label>
                            <input type="text" class="form-control" value="@PacienteTexto" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tipo de Registro *</label>
                            <InputSelect @bind-Value="currentRegistro.Tipo" class="form-select">
                                @foreach (var tipo in tipos)
                                {
                                    <option value="@tipo.Value">@tipo.Display</option>
                                }
                            </InputSelect>
                            <div class="form-text">@tipos.FirstOrDefault(t => t.Value == currentRegistro.Tipo).Descripcion</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Turno de Origen</label>
                            <InputSelect @bind-Value="currentRegistro.TurnoId" @bind-Value:after="OnTurnoChanged" class="form-select">
                                <option value="0">Registro general (sin turno)</option>
                                @foreach (var turno in turnosAtendidos)
                                {
                                    <option value="@turno.Id">[#TRN-@turno.Id] @turno.FechaHoraInicio.ToString("dd/MM/yyyy") (@turno.FechaHoraInicio.ToString("HH:mm") - @turno.FechaHoraFin.ToString("HH:mm")) — @ProfesionalNombre(turno.ProfesionalId)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Profesional *</label>
                            <InputSelect @bind-Value="currentRegistro.ProfesionalId" class="form-select" disabled="@(profesionalLogueadoId.HasValue || currentRegistro.TurnoId > 0)">
                                <option value="0">Seleccionar Profesional</option>
                                @foreach (var profesional in profesionales)
                                {
                                    <option value="@profesional.Id">@profesional.Apellido, @profesional.Nombre</option>
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Profesional"))
                            {
                                <div class="text-danger small">@validationErrors["Profesional"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea @bind-Value="currentRegistro.Descripcion" class="form-control" rows="4" />
                            <div class="form-text">@(currentRegistro.Descripcion?.Length ?? 0) / 500 car.</div>
                            @if (validationErrors.ContainsKey("Descripcion"))
                            {
                                <div class="text-danger small">@validationErrors["Descripcion"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnRegistroChanged { get; set; }

    private bool showModal = false;
    private RegistroClinicoCreateDTO currentRegistro = new RegistroClinicoCreateDTO();
    private PacienteDTO paciente = new PacienteDTO();
    private HistoriaClinicaDTO? historiaClinica;
    private List<TurnoDTO> turnosAtendidos = new();
    private List<ProfesionalDTO> profesionales = new();
    private int? profesionalLogueadoId;
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    // Tipos de registro, en el orden y con las descripciones de WinForms
    private readonly List<(string Value, string Display, string Descripcion)> tipos = new()
    {
        ("Evolucion", "Evolución médica", "Evolución: Registra la actualización clínica del cuadro, hallazgos semiológicos y respuesta al tratamiento."),
        ("NotaClinica", "Nota clínica", "Nota clínica: Observaciones generales, comentarios o anotaciones administrativas-asistenciales."),
        ("Diagnostico", "Diagnóstico", "Diagnóstico: Registra diagnósticos presuntivos, sindrómicos o de certeza del paciente."),
        ("Tratamiento", "Tratamiento", "Tratamiento: Terapéutica indicada, plan farmacológico, posología y recomendaciones."),
        ("Antecedente", "Antecedente", "Antecedente: Historia patológica previa, quirúrgica, familiar o factores de riesgo."),
        ("Alergia", "Alergia", "Alergia: Registra reacciones adversas o hipersensibilidad a medicamentos o sustancias."),
        ("Otro", "Otro", "Otro: Registro de índole clínica general no clasificado en las categorías anteriores.")
    };

    public async Task ShowAddModal(PacienteDTO paciente, HistoriaClinicaDTO? historiaClinica, List<TurnoDTO> turnosPaciente, List<ProfesionalDTO> profesionales)
    {
        this.paciente = paciente;
        this.historiaClinica = historiaClinica;
        this.profesionales = profesionales;
        // Regla de dominio: solo los turnos Atendidos pueden ser origen de un registro clínico
        turnosAtendidos = turnosPaciente
            .Where(t => t.EstadoTurno == "Atendido")
            .OrderByDescending(t => t.FechaHoraInicio)
            .ToList();
        currentRegistro = new RegistroClinicoCreateDTO { Tipo = tipos[0].Value, TurnoId = 0 };

        // El registro lo firma el profesional logueado (PersonaId del token)
        profesionalLogueadoId = await AuthService.GetPersonaIdAsync();
        if (profesionalLogueadoId.HasValue)
        {
            currentRegistro.ProfesionalId = profesionalLogueadoId.Value;
        }

        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    // Con turno de origen, el profesional es el del turno (la API exige que coincidan)
    private void OnTurnoChanged()
    {
        var turno = turnosAtendidos.FirstOrDefault(t => t.Id == currentRegistro.TurnoId);
        if (turno != null)
        {
            currentRegistro.ProfesionalId = turno.ProfesionalId;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateRegistro())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            // Si el paciente aún no tiene Historia Clínica, se crea automáticamente
            if (historiaClinica == null)
            {
                historiaClinica = await HistoriaClinicaApiClient.CreateAsync(new HistoriaClinicaCreateDTO
                {
                    PacienteId = paciente.Id,
                    GrupoSanguineo = "NO_ESPECIFICADO"
                });
            }

            await HistoriaClinicaApiClient.AddRegistroAsync(historiaClinica.Id, new RegistroClinicoCreateDTO
            {
                Tipo = currentRegistro.Tipo,
                Descripcion = currentRegistro.Descripcion.Trim(),
                ProfesionalId = currentRegistro.ProfesionalId,
                TurnoId = currentRegistro.TurnoId > 0 ? currentRegistro.TurnoId : null
            });

            await OnRegistroChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateRegistro()
    {
        ClearValidationErrors();
        bool isValid = true;

        var descripcion = currentRegistro.Descripcion?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(descripcion))
        {
            validationErrors["Descripcion"] = "La descripción del registro clínico es obligatoria.";
            isValid = false;
        }
        else if (descripcion.Length > 500)
        {
            validationErrors["Descripcion"] = $"La descripción excede el límite permitido de 500 caracteres (longitud actual: {descripcion.Length}).";
            isValid = false;
        }

        if (currentRegistro.ProfesionalId <= 0)
        {
            validationErrors["Profesional"] = "Debe seleccionar un profesional";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private string PacienteTexto => $"{paciente.Apellido}, {paciente.Nombre} (DNI: {paciente.NroDocumento})";

    private string ProfesionalNombre(int profesionalId)
    {
        var profesional = profesionales.FirstOrDefault(p => p.Id == profesionalId);
        return profesional != null ? $"{profesional.Apellido}, {profesional.Nombre}" : $"ID {profesionalId}";
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
